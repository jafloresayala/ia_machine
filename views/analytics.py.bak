"""Playground - analisis avanzado: outliers, correlacion, distribuciones, anomalias.

Lazy loading por pestana: los metadatos de tags se cargan sin limite al inicio,
pero los datos reales solo se descargan cuando el usuario selecciona parametros.
"""
from datetime import datetime, timedelta, date, time

import streamlit as st
import pandas as pd
import altair as alt

from theme import page_header, COLORS
from api_client import fetch_tag_values
from machine_registry import discover_machines, get_machine_tags
from dashboard_builder import infer_tag_mode, _numeric_outlier_chart, _histogram_chart
from analytics import numeric_summary, correlation_matrix, detect_anomalies


# ----------------------------------------------------------------
# Selector de rango de tiempo (identico al de Live Monitor)
# ----------------------------------------------------------------
def _pick_time_range() -> tuple[datetime, datetime, str]:
    """
    Devuelve (from_dt, to_dt, label).
    Modo Ventana: ultimos N minutos desde ahora.
    Modo Rango:   fechas/horas exactas con precision de segundos.
    """
    mode = st.radio(
        "Modo de tiempo",
        ["â± Ventana rapida", "ðŸ“… Rango exacto"],
        horizontal=True,
        label_visibility="collapsed",
    )

    if mode == "â± Ventana rapida":
        window_min = st.select_slider(
            "Ventana",
            options=[5, 10, 15, 30, 60, 120, 240, 480, 1440],
            value=st.session_state.get("analytics_window", 60),
            format_func=lambda m: f"Ultimos {m} min" if m < 60 else f"Ultimas {m//60}h" if m % 60 == 0 else f"Ultimas {m//60}h {m%60}m",
        )
        st.session_state.analytics_window = window_min
        to_dt = datetime.now()
        from_dt = to_dt - timedelta(minutes=window_min)
        label = f"ultimos {window_min} min" if window_min < 60 else f"ultimas {window_min//60}h"
    else:
        now = datetime.now()
        default_from = now - timedelta(hours=1)

        st.markdown("""
        <div style='display:flex;gap:8px;align-items:center;margin-bottom:0.4rem;'>
          <span style='font-size:0.8rem;font-weight:600;color:#6366f1;letter-spacing:.05em;'>DESDE</span>
          <div style='flex:1;height:1px;background:linear-gradient(90deg,#6366f1,transparent)'></div>
        </div>""", unsafe_allow_html=True)
        fc1, fc2, fc3 = st.columns([3, 3, 1])
        with fc1:
            from_date = st.date_input("ðŸ“… Fecha", value=default_from.date(), key="lab_from_date")
        with fc2:
            from_time = st.time_input("ðŸ• Hora : Min", value=time(default_from.hour, default_from.minute, 0), key="lab_from_time", step=60)
        with fc3:
            from_sec = st.number_input("Seg", min_value=0, max_value=59, value=0, key="lab_from_sec")

        st.markdown("""
        <div style='display:flex;gap:8px;align-items:center;margin:0.5rem 0 0.4rem;'>
          <span style='font-size:0.8rem;font-weight:600;color:#06b6d4;letter-spacing:.05em;'>HASTA</span>
          <div style='flex:1;height:1px;background:linear-gradient(90deg,#06b6d4,transparent)'></div>
        </div>""", unsafe_allow_html=True)
        tc1, tc2, tc3 = st.columns([3, 3, 1])
        with tc1:
            to_date = st.date_input("ðŸ“… Fecha", value=now.date(), key="lab_to_date")
        with tc2:
            to_time = st.time_input("ðŸ• Hora : Min", value=time(now.hour, now.minute, 0), key="lab_to_time", step=60)
        with tc3:
            to_sec = st.number_input("Seg", min_value=0, max_value=59, value=0, key="lab_to_sec")

        from_dt = datetime.combine(from_date, from_time).replace(second=from_sec)
        to_dt   = datetime.combine(to_date,   to_time).replace(second=to_sec)

        if from_dt >= to_dt:
            st.error("âš ï¸ La fecha de inicio debe ser anterior a la fecha fin.")
            st.stop()

        delta = to_dt - from_dt
        total_sec = int(delta.total_seconds())
        total_min = total_sec // 60
        h, m = divmod(total_min, 60)
        duration_str = f"{h}h {m}m" if h else f"{m}m {total_sec % 60}s"
        st.markdown(
            f"<div style='margin-top:0.5rem;padding:0.45rem 0.75rem;border-radius:8px;"
            f"background:rgba(99,102,241,.08);border:1px solid rgba(99,102,241,.2);"
            f"font-size:0.82rem;color:#6366f1;'>"
            f"â± <b>{from_dt.strftime('%d/%m/%Y %H:%M:%S')}</b>"
            f" &nbsp;â†’&nbsp; "
            f"<b>{to_dt.strftime('%d/%m/%Y %H:%M:%S')}</b>"
            f" &nbsp;Â·&nbsp; {duration_str}</div>",
            unsafe_allow_html=True,
        )
        label = f"{from_dt.strftime('%d/%m %H:%M:%S')} â†’ {to_dt.strftime('%d/%m %H:%M:%S')} ({duration_str})"

    return from_dt, to_dt, label


# ----------------------------------------------------------------
# Tipos de parametro: normalizacion y colores (emoji)
# ----------------------------------------------------------------
_TYPE_EMOJI = {
    "float":    "ðŸŸ¢",
    "int":      "ðŸ”µ",
    "bool":     "ðŸŸ¡",
    "string":   "ðŸŸ ",
    "datetime": "ðŸŸ£",
    "unknown":  "âš«",
}

def _normalize_type(raw) -> str:
    """Mapea el tipo PI a una categoria normalizada."""
    r = str(raw or "").lower().strip()
    if any(x in r for x in ("double", "float", "single", "real", "number")):
        return "float"
    if any(x in r for x in ("int", "integer", "long", "int32", "int64")):
        return "int"
    if any(x in r for x in ("bool", "boolean", "digital")):
        return "bool"
    if any(x in r for x in ("string", "text", "str")):
        return "string"
    if any(x in r for x in ("time", "date", "timestamp")):
        return "datetime"
    return "unknown"


# ----------------------------------------------------------------
# Helper: obtener todos los tags de una maquina (sin limite, sin datos)
# ----------------------------------------------------------------
def _get_all_tags(machine_path: str):
    """Devuelve lista de piPoint completos, dict short_map y dict type_map."""
    tags_df = get_machine_tags(machine_path)
    if tags_df.empty:
        return [], {}, {}
    full_names = tags_df["piPoint"].astype(str).tolist()
    short_map = {}   # full_tag -> short_name
    type_map  = {}   # full_tag -> normalized_type
    for _, row in tags_df.iterrows():
        full = str(row["piPoint"])
        short = full.split(".")[-1] if "." in full else full
        short_map[full] = short
        type_map[full]  = _normalize_type(row.get("type", ""))
    return full_names, short_map, type_map


# ----------------------------------------------------------------
# Helper: fetch datos para los tags seleccionados
# ----------------------------------------------------------------
def _fetch_selected(tag_names: list, from_dt, to_dt) -> dict:
    """Retorna tag_data: {full_tag: DataFrame} solo para los tags dados."""
    if not tag_names:
        return {}
    with st.spinner(f"Cargando datos de {len(tag_names)} parametros..."):
        raw = fetch_tag_values(tag_names, from_dt, to_dt)
    td = {}
    for tn in tag_names:
        sub = raw[raw["Tag_Name"] == tn].copy()
        if not sub.empty:
            td[tn] = sub
    return td


# ----------------------------------------------------------------
# RENDER
# ----------------------------------------------------------------
def render():
    page_header(
        eyebrow="Intelligence Â· Playground",
        title="Playground",
        subtitle="Explora outliers, correlaciones, distribuciones y anomalias de cualquier maquina.",
    )

    df = discover_machines()
    if df is None or df.empty:
        st.warning("No hay maquinas disponibles.")
        return

    # â”€â”€ Two-column layout: config (left) | analysis (right) â”€â”€
    col_cfg, col_main = st.columns([1, 2.6], gap="medium")

    # â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    # LEFT â€” configuraciÃ³n
    # â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    with col_cfg:
        st.markdown(
            "<div style='background:linear-gradient(135deg,#4f46e5,#7c3aed);"
            "border-radius:12px;padding:12px 16px;margin-bottom:14px;'>"
            "<div style='color:#fff;font-size:0.72rem;font-weight:700;letter-spacing:.1em;"
            "text-transform:uppercase;opacity:.8;'>Paso 1</div>"
            "<div style='color:#fff;font-size:1rem;font-weight:700;'>Maquina</div>"
            "</div>",
            unsafe_allow_html=True,
        )
        options_list = (df["machine_name"] + "  Â·  " + df["line_name"]).tolist()
        sel = st.selectbox("Maquina", options=options_list, index=0, label_visibility="collapsed")
        row = df.iloc[options_list.index(sel)]
        st.session_state.analytics_machine = row["machine_name"]

        # Tag metadata
        all_tags, short_map, type_map = _get_all_tags(row["machine_path"])

        if not all_tags:
            st.info("Esta maquina no tiene tags configurados.")
            return

        # Counts por tipo
        from collections import Counter
        type_counts = Counter(type_map.values())
        tc_cols = st.columns(2)
        for i, (typ, emoji) in enumerate(
            [(t, _TYPE_EMOJI.get(t, "âš«")) for t in ["float", "int", "bool", "string"] if t in type_counts]
        ):
            tc_cols[i % 2].markdown(
                f"<div style='background:#f1f5f9;border-radius:8px;padding:6px 10px;margin-bottom:6px;"
                f"font-size:0.78rem;'>{emoji} <b>{type_counts[typ]}</b> {typ}</div>",
                unsafe_allow_html=True,
            )

        st.divider()

        st.markdown(
            "<div style='background:linear-gradient(135deg,#06b6d4,#0891b2);"
            "border-radius:12px;padding:12px 16px;margin-bottom:14px;'>"
            "<div style='color:#fff;font-size:0.72rem;font-weight:700;letter-spacing:.1em;"
            "text-transform:uppercase;opacity:.8;'>Paso 2</div>"
            "<div style='color:#fff;font-size:1rem;font-weight:700;'>Rango de tiempo</div>"
            "</div>",
            unsafe_allow_html=True,
        )
        from_dt, to_dt, time_label = _pick_time_range()

        st.divider()

        st.markdown(
            "<div style='background:linear-gradient(135deg,#10b981,#059669);"
            "border-radius:12px;padding:12px 16px;margin-bottom:14px;'>"
            "<div style='color:#fff;font-size:0.72rem;font-weight:700;letter-spacing:.1em;"
            "text-transform:uppercase;opacity:.8;'>Paso 3</div>"
            "<div style='color:#fff;font-size:1rem;font-weight:700;'>Tipo de analisis</div>"
            "</div>",
            unsafe_allow_html=True,
        )
        SECTIONS = {
            "outliers":       ("ðŸ“ˆ", "Outliers",       "Detecta valores fuera de rango con bandas sigma"),
            "correlacion":    ("ðŸ”—", "Correlacion",    "Matriz de Pearson entre parametros"),
            "distribuciones": ("ðŸ“Š", "Distribuciones", "Histogramas y estadisticas por parametro"),
            "anomalias":      ("ðŸš¨", "Anomalias",      "Puntos atipicos por z-score"),
        }
        if "playground_section" not in st.session_state:
            st.session_state.playground_section = "outliers"

        for key, (icon, label, desc) in SECTIONS.items():
            is_active = st.session_state.playground_section == key
            border_color = "#4f46e5" if is_active else "#e2e8f0"
            bg_color = "rgba(79,70,229,0.06)" if is_active else "#fff"
            label_color = "#4f46e5" if is_active else "#0f172a"
            st.markdown(
                f"<div style='border:1.5px solid {border_color};border-radius:10px;"
                f"background:{bg_color};padding:10px 12px;margin-bottom:6px;cursor:pointer;'>",
                unsafe_allow_html=True,
            )
            if st.button(
                f"{icon} **{label}**\n\n{desc}",
                key=f"pg_nav_{key}",
                use_container_width=True,
                type="primary" if is_active else "secondary",
            ):
                st.session_state.playground_section = key
                st.rerun()
            st.markdown("</div>", unsafe_allow_html=True)

    # â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    # RIGHT â€” anÃ¡lisis
    # â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    with col_main:
        section = st.session_state.playground_section
        icon, label, desc = SECTIONS[section]

        # Section header
        st.markdown(
            f"<div style='display:flex;align-items:center;gap:12px;padding:14px 18px;"
            f"background:#fff;border:1px solid #e2e8f0;border-radius:14px;margin-bottom:16px;"
            f"box-shadow:0 1px 4px rgba(15,23,42,.04);'>"
            f"<span style='font-size:1.8rem;'>{icon}</span>"
            f"<div><div style='font-size:1.05rem;font-weight:700;color:#0f172a;'>{label}</div>"
            f"<div style='font-size:0.82rem;color:#64748b;'>{desc}</div></div>"
            f"</div>",
            unsafe_allow_html=True,
        )

        def fmt_tag(t):
            short = short_map.get(t, t)
            typ   = type_map.get(t, "unknown")
            emoji = _TYPE_EMOJI.get(typ, "âš«")
            return f"{emoji} {short}  [{typ}]"

        # Leyenda de tipos (compacta)
        st.caption(
            "  ".join(f"{e} {k}" for k, e in _TYPE_EMOJI.items() if k != "unknown" and k in type_counts)
        )

        # â”€â”€ OUTLIERS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        if section == "outliers":
            c_sel, c_opt = st.columns([3, 1])
            with c_sel:
                sel_outlier = st.multiselect(
                    f"Parametros ({len(all_tags)} disponibles)",
                    options=all_tags,
                    default=all_tags[:min(3, len(all_tags))],
                    format_func=fmt_tag,
                    key="analytics_outlier_sel",
                )
            with c_opt:
                std_factor = st.slider("Sigma threshold", 1.0, 4.0, 2.0, 0.5, key="analytics_std")

            if not sel_outlier:
                st.info("ðŸ‘† Selecciona al menos un parametro para ver outliers.")
            else:
                td = _fetch_selected(sel_outlier, from_dt, to_dt)
                numeric_td = {n: d for n, d in td.items() if infer_tag_mode(d) == "numeric"}
                non_numeric = [n for n in td if n not in numeric_td]
                if non_numeric:
                    st.caption(f"âš ï¸ Omitidos (no numericos): " + ", ".join(fmt_tag(n) for n in non_numeric))
                if not numeric_td:
                    st.info("Ninguno de los parametros seleccionados tiene datos numericos.")
                else:
                    # Summary strip
                    total_outliers = 0
                    strip_cols = st.columns(min(4, len(numeric_td)))
                    tmp_stats = {}
                    for i, (tn, df_t) in enumerate(numeric_td.items()):
                        _, stats = _numeric_outlier_chart(df_t, fmt_tag(tn), std_factor=std_factor)
                        if stats:
                            tmp_stats[tn] = stats
                            total_outliers += stats.get("outlier_count", 0)
                            if i < 4:
                                strip_cols[i].metric(
                                    short_map.get(tn, tn),
                                    f"{stats.get('outlier_pct', 0):.1f}% outliers",
                                    f"{stats.get('outlier_count', 0)} pts",
                                )
                    st.divider()
                    for tn, df_t in numeric_td.items():
                        short = fmt_tag(tn)
                        chart, stats = _numeric_outlier_chart(df_t, short, std_factor=std_factor)
                        if chart is None:
                            st.caption(f"Sin datos suficientes en {short}.")
                            continue
                        with st.container(border=True):
                            st.markdown(f"**{short}**")
                            st.altair_chart(chart, use_container_width=True)
                            mc = st.columns(4)
                            mc[0].metric("Sigma", f"{stats.get('std', 0):.3f}")
                            mc[1].metric("Upper", f"{stats.get('upper', 0):.3f}")
                            mc[2].metric("Lower", f"{stats.get('lower', 0):.3f}")
                            mc[3].metric("Outliers", f"{stats.get('outlier_count', 0)} ({stats.get('outlier_pct', 0):.1f}%)")

        # â”€â”€ CORRELACION â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        elif section == "correlacion":
            sel_corr = st.multiselect(
                f"Parametros para correlacion ({len(all_tags)} disponibles â€” solo numericos)",
                options=all_tags,
                default=all_tags[:min(6, len(all_tags))],
                format_func=fmt_tag,
                key="analytics_corr_sel",
            )
            if len(sel_corr) < 2:
                st.info("ðŸ‘† Selecciona al menos 2 parametros.")
            else:
                td = _fetch_selected(sel_corr, from_dt, to_dt)
                numeric_td = {n: d for n, d in td.items() if infer_tag_mode(d) == "numeric"}
                if len(numeric_td) < 2:
                    st.warning(f"Solo {len(numeric_td)} parametros numericos. Se necesitan al menos 2.")
                else:
                    corr = correlation_matrix(numeric_td)
                    if corr is None or corr.empty:
                        st.info("No hay suficientes datos coincidentes en el tiempo para calcular correlacion.")
                    else:
                        corr_long = corr.reset_index().melt(id_vars="index", var_name="param_b", value_name="corr")
                        corr_long.rename(columns={"index": "param_a"}, inplace=True)
                        corr_long["param_a"] = corr_long["param_a"].apply(fmt_tag)
                        corr_long["param_b"] = corr_long["param_b"].apply(fmt_tag)

                        heat = (
                            alt.Chart(corr_long)
                            .mark_rect()
                            .encode(
                                x=alt.X("param_a:N", title=None, axis=alt.Axis(labelAngle=-35)),
                                y=alt.Y("param_b:N", title=None),
                                color=alt.Color("corr:Q", scale=alt.Scale(scheme="redblue", domain=[-1, 1]), title="rho"),
                                tooltip=[
                                    alt.Tooltip("param_a:N", title="A"),
                                    alt.Tooltip("param_b:N", title="B"),
                                    alt.Tooltip("corr:Q", title="Pearson", format=".3f"),
                                ],
                            )
                            .properties(height=max(260, 32 * len(corr)), title="Matriz de correlacion de Pearson")
                        )
                        text_layer = (
                            alt.Chart(corr_long)
                            .mark_text(baseline="middle", fontSize=10)
                            .encode(
                                x="param_a:N", y="param_b:N",
                                text=alt.Text("corr:Q", format=".2f"),
                                color=alt.condition(
                                    "abs(datum.corr) > 0.6",
                                    alt.value("white"), alt.value(COLORS["ink"]),
                                ),
                            )
                        )
                        st.altair_chart(heat + text_layer, use_container_width=True)

                        # Top pares
                        pairs = []
                        names = list(corr.columns)
                        for i in range(len(names)):
                            for j in range(i + 1, len(names)):
                                r = corr.iloc[i, j]
                                if pd.isna(r):
                                    continue
                                pairs.append({
                                    "Parametro A": fmt_tag(names[i]),
                                    "Parametro B": fmt_tag(names[j]),
                                    "Pearson rho": round(r, 3),
                                    "Fuerza": "ðŸ”´ Fuerte" if abs(r) > 0.7 else "ðŸŸ¡ Moderada" if abs(r) > 0.4 else "âšª Debil",
                                })
                        if pairs:
                            pairs_df = (
                                pd.DataFrame(pairs)
                                .sort_values("Pearson rho", key=lambda s: s.abs(), ascending=False)
                            )
                            st.markdown("##### Top pares correlacionados")
                            st.dataframe(pairs_df.head(20), use_container_width=True, hide_index=True)

        # â”€â”€ DISTRIBUCIONES â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        elif section == "distribuciones":
            sel_dist = st.multiselect(
                f"Parametros ({len(all_tags)} disponibles â€” solo numericos graficados)",
                options=all_tags,
                default=all_tags[:min(4, len(all_tags))],
                format_func=fmt_tag,
                key="analytics_dist_sel",
            )
            if not sel_dist:
                st.info("ðŸ‘† Selecciona al menos un parametro.")
            else:
                td = _fetch_selected(sel_dist, from_dt, to_dt)
                numeric_td = {n: d for n, d in td.items() if infer_tag_mode(d) == "numeric"}
                non_numeric = [n for n in td if n not in numeric_td]
                if non_numeric:
                    st.caption(f"âš ï¸ Omitidos (no numericos): " + ", ".join(fmt_tag(n) for n in non_numeric))
                if not numeric_td:
                    st.info("Ninguno de los parametros seleccionados tiene datos numericos.")
                else:
                    # Summary metrics row
                    mc = st.columns(min(4, len(numeric_td)))
                    for i, (tn, df_t) in enumerate(list(numeric_td.items())[:4]):
                        s = numeric_summary(df_t)
                        if s and i < 4:
                            mc[i].metric(short_map.get(tn, tn), f"Î¼ {s['mean']:.2f}", f"Ïƒ {s['std']:.2f}")
                    st.divider()
                    g_cols = st.columns(2)
                    for i, (tn, df_t) in enumerate(numeric_td.items()):
                        short = fmt_tag(tn)
                        with g_cols[i % 2]:
                            with st.container(border=True):
                                st.markdown(f"**{short}**")
                                hist = _histogram_chart(df_t, short)
                                if hist is not None:
                                    st.altair_chart(hist, use_container_width=True)
                                else:
                                    st.caption("Sin datos suficientes.")
                                s = numeric_summary(df_t)
                                if s:
                                    sm = st.columns(4)
                                    sm[0].metric("Media", f"{s['mean']:.2f}")
                                    sm[1].metric("Sigma", f"{s['std']:.2f}")
                                    sm[2].metric("IQR",   f"{s['iqr']:.2f}")
                                    sm[3].metric("Rango",  f"{s['range']:.2f}")

        # â”€â”€ ANOMALIAS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        elif section == "anomalias":
            c_sel, c_opt = st.columns([3, 1])
            with c_sel:
                sel_anom = st.multiselect(
                    f"Parametros ({len(all_tags)} disponibles â€” solo numericos)",
                    options=all_tags,
                    default=all_tags[:min(5, len(all_tags))],
                    format_func=fmt_tag,
                    key="analytics_anom_sel",
                )
            with c_opt:
                z_th = st.slider("Z-score threshold", 1.5, 4.0, 2.5, 0.25, key="analytics_z")

            if not sel_anom:
                st.info("ðŸ‘† Selecciona al menos un parametro.")
            else:
                td = _fetch_selected(sel_anom, from_dt, to_dt)
                numeric_td = {n: d for n, d in td.items() if infer_tag_mode(d) == "numeric"}
                if not numeric_td:
                    st.info("Ninguno de los parametros seleccionados tiene datos numericos.")
                else:
                    # Summary: count anomalias por tag
                    summary_rows = []
                    tag_anomalies = {}
                    for tn, df_t in numeric_td.items():
                        anom = detect_anomalies(df_t, z_threshold=z_th)
                        tag_anomalies[tn] = anom
                        summary_rows.append({
                            "Parametro": fmt_tag(tn),
                            "Total puntos": len(df_t),
                            "Anomalias": len(anom),
                            "% anomalo": f"{100*len(anom)/max(len(df_t),1):.1f}%",
                            "Estado": "ðŸ”´ Revisar" if len(anom) > 0 else "ðŸŸ¢ Normal",
                        })

                    # Summary table
                    st.markdown("##### Resumen por parametro")
                    st.dataframe(
                        pd.DataFrame(summary_rows),
                        use_container_width=True, hide_index=True,
                    )
                    st.divider()

                    # Detail per tag with anomalies
                    any_found = False
                    for tn, anom in tag_anomalies.items():
                        if anom.empty:
                            continue
                        any_found = True
                        short = fmt_tag(tn)
                        with st.container(border=True):
                            h1, h2 = st.columns([3, 1])
                            h1.markdown(f"**{short}**")
                            h2.markdown(
                                f"<div style='text-align:right;color:#ef4444;"
                                f"font-weight:700;'>{len(anom)} anomalias</div>",
                                unsafe_allow_html=True,
                            )
                            show = anom[["TimeStamp", "Value_Num", "z_score"]].copy()
                            show.columns = ["Timestamp", "Valor", "Z-score"]
                            show["Z-score"] = show["Z-score"].round(2)
                            show["Valor"] = show["Valor"].round(4)
                            st.dataframe(show.head(30), use_container_width=True, hide_index=True, height=240)

                    if not any_found:
                        st.success("âœ… No se detectaron anomalias significativas con el threshold actual.")


